# ---------------------------------------------------------------------------
# Copy to .env and fill in. ONLY the first line is required to run the kit.
# Everything else is an upgrade you can add later without touching code.
# ---------------------------------------------------------------------------

# REQUIRED - the capped key handed to you at the registration desk.
OPENROUTER_API_KEY=

# Chosen by running scripts/bakeoff.py TWICE, not by reading a pricing page.
# 8/8 perfect across both runs on parse, schema, correct BLOCK and objection
# specificity. Fastest at ~2.0s, and the cheapest thing that behaved.
# PINNED VERSION: never a ":batch" variant (not callable via /chat/completions)
# and never a "~...latest" alias - a judge re-running your demo must get the
# same behaviour.
SLICE_MODEL=inclusionai/ling-3.0-flash

# Availability insurance, deliberately a different provider family. Also 8/8,
# 2.4s, from an established lab served by several providers - so if the default
# has an outage this is a real safety net and not a second single point of failure.
SLICE_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Rejected, and why - so nobody helpfully "optimises" these back in:
#   qwen/qwen3.7-flash   cheap, 1M context, and unusable. Unparseable output on
#                        one run, HTTP 429 on the next. Two runs, two failures.
#   z-ai/glm-5.3-flash   3/3 on the first run, 2/5 on the second, at temperature
#                        zero. Intermittent contract compliance is worse than
#                        none: the failure looks like YOUR bug.
#   openai/gpt-oss-120b  perfect but ~11.5s per call. In a gate loop that
#                        revises three times, that is a demo which feels hung.

SLICE_ESCALATION_MODEL=anthropic/claude-haiku-4.5

# OPTIONAL - free tier, 1B tokens/month. If set, cheap calls route here first.
# Needs phone verification and a data-training opt-in: do not put anything
# confidential through this key.
MISTRAL_API_KEY=

# OPTIONAL - tracing. If these are blank the tracer no-ops and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Budgets. These are the fences. Lower them, never raise them casually.
SLICE_MAX_TOKENS_PER_RUN=250000
# Per-request output ceiling. Kept low on purpose: OpenRouter reserves against
# max_tokens, so an over-large value makes requests fail with HTTP 402 while
# you still have usable credit. Verified 3 Sep 2026.
SLICE_MAX_TOKENS=1200
SLICE_MAX_ATTEMPTS_PER_STEP=3
SLICE_EXPERT_TIMEOUT_MINUTES=45
